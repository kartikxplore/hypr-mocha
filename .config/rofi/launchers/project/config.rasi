/*****----- Configuration -----*****/
configuration {
    drun-display-format: "{name}";
}

/*****----- Global Styles -----*****/
* {
    font: "GeistMono Nerd Font 12";
    /* Catppuccin Mocha Colors */
    text-color: #cdd6f4; /* Text */
    background-color: rgba(30, 30, 46, 0.6);  /* Base with transparency */
    border: 0px;
    padding: 0;
    spacing: 0;
}

/*****----- Window -----*****/
window {
    transparency: "real";
    blur: true;
    padding: 20px;
    width: 600px;
    height: 515px;
    border-radius: 20px;
}

/*****----- Layout -----*****/
mainbox {
    padding: 10px;
    children: [inputbar, listview];
    spacing: 15px;
    border-radius: 15px;
}

inputbar {
    children: [entry];
    background-color: rgba(49, 50, 68, 0.8);  /* Surface0 */
    border-radius: 7px;
    padding: 6px 12px;
}

entry {
    expand: true;
    text-color: #cdd6f4; /* Text */
    background-color: transparent;
    cursor: text;
    placeholder: "Enter Command...";
    placeholder-color: #6c7086; /* Overlay0 */
}

listview {
    lines: 12;
    dynamic: true;
    fixed-height: false;
    scrollbar: false;
    padding: 0;
    border-radius: 10px;
    spacing: 6px;
}

/*****----- Elements -----*****/
element {
    padding: 12px;
    border-radius: 6px;
    background-color: transparent;
    horizontal-align: 0.5;
}

element-icon {
  size: 0;
}

element-text {
    background-color: transparent;
    vertical-align: 0.5;
    text-color: #cdd6f4; /* Text */
}

element selected {
    background-color: rgba(203, 166, 247, 0.2);  /* Mauve highlight */
    text-color: #cdd6f4; /* Text */
}
